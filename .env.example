# Copy to .env.local and fill in. Never commit .env.local.
# Both local and prod use Postgres (Neon). Use a Neon branch URL for local dev.
# DATABASE_URL=<pooled URL>, DIRECT_URL=<direct URL>
DATABASE_URL="postgresql://user:password@localhost:5432/campusconnect"
DIRECT_URL="postgresql://user:password@localhost:5432/campusconnect"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
