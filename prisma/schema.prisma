generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   // ADMIN, TEACHER, STUDENT
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teachingSubjects Subject[]       @relation("TeacherSubjects")
  timetables       Timetable[]     @relation("TeacherTimetables")
  assignments      Assignment[]    @relation("TeacherAssignments")
  createdExams     Exam[]          @relation("TeacherExams")
  markedAttendance Attendance[]    @relation("AttendanceMarker")
  gradedSubs       Submission[]    @relation("SubmissionGrader")

  enrollments     Enrollment[]
  attendance      Attendance[]     @relation("StudentAttendance")
  submissions     Submission[]     @relation("StudentSubmissions")
  examSubmissions ExamSubmission[]
  grades          Grade[]
  invoices        FeeInvoice[]

  @@index([role])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   Class[]
}

model Class {
  id           String   @id @default(uuid())
  name         String
  section      String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subjects    Subject[]
  enrollments Enrollment[]
  timetables  Timetable[]
  attendance  Attendance[]
  feeStructs  FeeStructure[]
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, classId])
  @@index([classId])
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   User?    @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetables  Timetable[]
  attendance  Attendance[]
  assignments Assignment[]
  exams       Exam[]
  grades      Grade[]

  @@index([teacherId])
  @@index([classId])
}

model Timetable {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("TeacherTimetables", fields: [teacherId], references: [id], onDelete: Restrict)
  dayOfWeek String   // MONDAY..SATURDAY
  startTime String   // HH:MM
  endTime   String   // HH:MM
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([classId])
}

model Attendance {
  id         String   @id @default(uuid())
  studentId  String
  student    User     @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date       DateTime
  status     String   // PRESENT, ABSENT, LATE
  markedById String?
  markedBy   User?    @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([studentId, subjectId, date])
  @@index([classId])
  @@index([studentId])
  @@index([markedById, date])
}

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User     @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  deadline    DateTime
  maxMarks    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]
}

model Submission {
  id            String     @id @default(uuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  content       String?
  submittedAt   DateTime   @default(now())
  marksObtained Int?
  feedback      String?
  gradedById    String?
  gradedBy      User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
}

model Exam {
  id          String   @id @default(uuid())
  name        String
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  totalMarks  Int
  duration    Int      // minutes
  isPublished Boolean  @default(false)
  createdById String
  createdBy   User     @relation("TeacherExams", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]
  submissions ExamSubmission[]
}

model Question {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText  String
  options       String   // JSON array string
  correctOption Int
  marks         Int
}

model ExamSubmission {
  id          String   @id @default(uuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     String   // JSON array string
  score       Int?
  submittedAt DateTime @default(now())

  @@unique([examId, studentId])
  @@index([examId])
}

model Grade {
  id            String   @id @default(uuid())
  studentId     String
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marksObtained Int
  totalMarks    Int
  grade         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, subjectId])
  @@index([studentId])
}

model FeeStructure {
  id        String   @id @default(uuid())
  name      String
  amount    Float
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  createdAt DateTime @default(now())

  invoices FeeInvoice[]
}

model FeeInvoice {
  id             String       @id @default(uuid())
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  amount         Float
  dueDate        DateTime
  status         String       @default("UNPAID")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payments FeePayment[]

  @@index([studentId, status])
}

model FeePayment {
  id        String     @id @default(uuid())
  invoiceId String
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String     @default("CASH")
  status    String     @default("COMPLETED")
  paidAt    DateTime   @default(now())

  @@index([invoiceId])
}
